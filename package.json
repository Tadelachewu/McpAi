{
  "name": "mcp-ai-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js AI calculator: Ollama qwen3:8b + real MCP client/server tool calling",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "mcp:server": "tsx mcp-server/index.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector node node_modules/tsx/dist/cli.mjs mcp-server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ollama": "cross-env RUN_OLLAMA_TESTS=1 vitest run tests/integration/ollama.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "decimal.js": "^10.6.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
