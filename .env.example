# Copy to .env.local and adjust if needed. All values are SERVER-SIDE ONLY.
# Never rename these with a NEXT_PUBLIC_ prefix: that would ship them to the browser.
# Local Ollama needs no API key. OPENROUTER_API_KEY (optional) is a secret: keep it in .env.local only.

# Local Ollama endpoint and model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Per model-call timeout (ms). The first call after startup may need time to load the model into memory.
OLLAMA_TIMEOUT_MS=180000
# qwen3 "thinking" mode. false = faster answers; reasoning text is never shown either way.
OLLAMA_THINK=false
# How long Ollama keeps the model loaded after a request
OLLAMA_KEEP_ALIVE=10m

# Optional: OpenRouter instead of local Ollama. If OPENROUTER_API_KEY is set, OpenRouter is used;
# if it is empty or missing, the app uses the local Ollama settings above.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=120000
# Ask the model to reason (reasoning_details are passed back to it between tool rounds; never shown)
OPENROUTER_REASONING=true

# Agent loop bounds
MAX_TOOL_ITERATIONS=5
MAX_TOOL_CALLS_PER_TURN=4

# MCP calculator server (spawned automatically over stdio by the Next.js server)
MCP_TOOL_TIMEOUT_MS=10000
MCP_CONNECT_TIMEOUT_MS=30000

# Security: the API only accepts requests addressed to localhost/127.0.0.1.
# Read the README "Security" section before setting this to true.
ALLOW_NON_LOCAL_REQUESTS=false
